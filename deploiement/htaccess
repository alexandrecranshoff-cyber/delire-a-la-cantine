# Délire à la cantine : réglages du serveur pour la version web, copiés dans htdocs/cantine/ par le workflow « Mise en ligne sur iomino.fr »

# Types de fichiers : le navigateur refuse le .wasm s'il n'est pas annoncé comme tel
AddType application/wasm .wasm
AddType application/octet-stream .pck
AddType text/javascript .js

# Compression à la volée : le .wasm passe d'environ 37 Mo à environ 9 Mo transférés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/javascript application/javascript application/wasm application/octet-stream
</IfModule>

# Le navigateur revérifie les fichiers à chaque visite : une mise à jour du jeu est vue tout de suite
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
  # Site non référencé : les moteurs de recherche n'indexent pas le jeu.
  # Supprimer la ligne suivante le jour où le jeu est ouvert à tous.
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

