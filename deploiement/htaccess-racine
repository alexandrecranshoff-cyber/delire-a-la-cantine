# Délire à la cantine : réglages du serveur pour le site de présentation (racine), copiés par le workflow « Mise en ligne sur iomino.fr »

# Page d'accueil
DirectoryIndex index.html

# Types de fichiers : le navigateur refuse le .wasm s'il n'est pas annoncé comme tel
AddType application/wasm .wasm
AddType application/octet-stream .pck
AddType text/javascript .js
AddType image/webp .webp
AddType font/ttf .ttf
AddType font/woff2 .woff2
AddType application/zip .zip

# Compression à la volée : le .wasm du jeu passe d'environ 37 Mo à environ 9 Mo transférés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/wasm application/octet-stream font/ttf
</IfModule>

<IfModule mod_headers.c>
  # Le navigateur revérifie les fichiers à chaque visite : une mise à jour du jeu est vue tout de suite
  Header set Cache-Control "no-cache"
</IfModule>

