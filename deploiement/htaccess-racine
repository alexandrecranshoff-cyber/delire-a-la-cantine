# Délire à la cantine : réglages du serveur pour le site de présentation (racine), copiés par le workflow « Mise en ligne sur iomino.fr »

# Page d'accueil
DirectoryIndex index.html

# Types de fichiers : le navigateur refuse le .wasm s'il n'est pas annoncé comme tel
AddType application/wasm .wasm
AddType application/octet-stream .pck
AddType text/javascript .js
AddType image/webp .webp
AddType font/ttf .ttf
AddType font/woff2 .woff2
AddType application/zip .zip

# Compression à la volée : le .wasm du jeu passe d'environ 37 Mo à environ 9 Mo transférés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/wasm application/octet-stream font/ttf
</IfModule>

<IfModule mod_headers.c>
  # Le navigateur revérifie les fichiers à chaque visite : une mise à jour du jeu est vue tout de suite
  Header set Cache-Control "no-cache"
</IfModule>

# Une seule adresse pour chaque page, celle des adresses canoniques et du sitemap : https://www.iomino.fr/...
# Sans cela, Google voit les mêmes pages en http et https, avec et sans www, et en écarte une partie comme doublons.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # http:// ou iomino.fr sans www → https://www.iomino.fr (redirection permanente)
  # (X-Forwarded-Proto : si l'hébergeur termine le https en amont, la requête arrive en http ; on ne redirige pas en boucle)
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ - [E=DOMAINE:%1]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://www.%{ENV:DOMAINE}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{ENV:DOMAINE}%{REQUEST_URI} [L,R=301]
  # /index.html → / et /en/index.html → /en/ (même page que l'accueil de chaque langue)
  RewriteCond %{THE_REQUEST} \s/(en/)?index\.html[\s?] [NC]
  RewriteRule ^(en/)?index\.html$ /$1 [L,R=301]
</IfModule>
